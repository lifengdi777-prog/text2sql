# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Logs
logs/

#docker 相关:忽略 mysql 目录,但放行 demo 业务库种子 SQL(供用户按 README 手动导入,不自动加载)。
#  注:不放行 meta.sql —— meta 库由应用自动建表(当前 schema),避免冲突。
docker/mysql/*
!docker/mysql/dw.sql
!docker/mysql/e-commerce.sql

#api密钥等敏感信息
conf/app_config.yaml

#chart_agent.md
agent/chart_agent/README.md

#test_data
test_data/

# 本地回归测试脚本(依赖 test_data,别人 clone 跑不了),不入库
/test/

# 内部设计文档,不入库
/docs/

# eval 跑批结果是再生产物,不入库;保留 .gitkeep 让目录存在
evals/baselines/*
!evals/baselines/.gitkeep

skills-main/

conf/meta_config*.json