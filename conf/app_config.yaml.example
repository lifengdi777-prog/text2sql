# ============================================================================
# 文枢(wenshu)配置模板
#
# 用法:
#   cp conf/app_config.yaml.example conf/app_config.yaml
#   然后把下面标了 ⚠️ 的项改成你自己的(主要是 LLM / embedding 的 api_key)。
#
# 说明:
#   * 真实的 app_config.yaml 已被 .gitignore 忽略,不会进仓库(含密钥,切勿提交)。
#   * host/port 用了 ${oc.env:VAR,默认值} 插值:
#       - 裸机运行:不设环境变量,走默认值 localhost + 对外端口,直接可用;
#       - 后端跑进 Docker:compose 会注入 WENSHU_* 环境变量,把 host 覆盖成
#         服务名(mysql/qdrant/...)、端口覆盖成容器内端口。同一份配置两种部署通用。
# ============================================================================

# ── 日志 ────────────────────────────────────────────────────────────────
logging:
  file:
    enable: true
    level: INFO
    path: logs
    rotation: "10 MB"     # 单文件超过即轮转
    retention: "7 days"   # 保留 7 天
  console:
    enable: true
    level: INFO

# ── 元数据库(应用自建,存 table_info/column_info/metric_info 等)────────────
db_meta:
  host: ${oc.env:WENSHU_MYSQL_HOST,localhost}
  port: ${oc.env:WENSHU_MYSQL_PORT,3307}   # 裸机=宿主映射端口 3307;容器内=3306
  user: root
  password: root          # ⚠️ 生产改成强密码,并与 compose 里 MYSQL_ROOT_PASSWORD 一致
  database: meta

# ── 数据仓库(你要问数的业务库;应用只读,不会自动创建)──────────────────────
db_dw:
  host: ${oc.env:WENSHU_MYSQL_HOST,localhost}   # 若 dw 是外部独立库,直接写死它的地址
  port: ${oc.env:WENSHU_MYSQL_PORT,3307}
  user: root
  password: root          # ⚠️ 生产改成强密码
  database: dw            # 改成你自己的业务库名

# ── 向量库(列/指标召回)───────────────────────────────────────────────────
qdrant:
  host: ${oc.env:WENSHU_QDRANT_HOST,localhost}
  port: 6333
  embedding_size: 1024    # 须与下方 embedding 模型的输出维度一致

# ── 本地 embedding 服务(可选;默认关,改用下面的 fallback)──────────────────
embedding:
  host: localhost
  port: 8081
  enable: false           # false=用 embedding_fallback;自建本地服务再设 true

# ── embedding 兜底(OpenAI 兼容 API;enable=false 时实际走这个)──────────────
embedding_fallback:
  base_url: https://dashscope.aliyuncs.com/compatible-mode/v1
  api_key: "YOUR_EMBEDDING_API_KEY"   # ⚠️ 必填:DashScope / OpenAI 兼容的 key
  model_name: text-embedding-v4       # 输出维度须与 qdrant.embedding_size 对齐
  max_batch_size: 10                  # DashScope=10;OpenAI 可填 2048

# ── 全文检索(值召回)──────────────────────────────────────────────────────
es:
  host: ${oc.env:WENSHU_ES_HOST,localhost}
  port: 9200
  index_name: value_info

# ── 大模型(问数主力)──────────────────────────────────────────────────────
llm:
  model_name: deepseek-v4-pro
  api_key: "YOUR_LLM_API_KEY"         # ⚠️ 必填:DeepSeek 或任意 OpenAI 兼容服务的 key
  base_url: https://api.deepseek.com
  # fast_model_name: deepseek-v4-flash  # 可选:表头检测等小任务用的快模型

# ── 对象存储(Excel 上传/数据集功能用;不用上传功能可保持默认)────────────────
s3:
  endpoint_url: ${oc.env:WENSHU_S3_ENDPOINT,"http://localhost:9000"}
  access_key: "minioadmin"            # ⚠️ 生产改掉,并与 compose 里 MINIO 凭据一致
  secret_key: "minioadmin"            # ⚠️ 生产改掉
  bucket: "wenshu-datasets"
  region: "us-east-1"                 # MinIO 无意义,占位即可

# ── 应用运营库(users / conversations / messages / upload_datasets 等)────────
db_upload:
  host: ${oc.env:WENSHU_MYSQL_HOST,localhost}
  port: ${oc.env:WENSHU_MYSQL_PORT,3307}
  user: root
  password: root                      # ⚠️ 生产改成强密码
  database: wenshu

# ── 登录鉴权(JWT)──────────────────────────────────────────────────────────
# ⚠️ 生产必须设一个随机强密钥,否则 token 可被伪造(启动会检测默认值并告警)。
#    生成示例:python -c "import secrets; print(secrets.token_urlsafe(48))"
auth:
  secret: "CHANGE_ME_TO_A_RANDOM_LONG_SECRET"
  # 管理员 admin 的初始密码(仅首次建账号时用)。留空=随机生成,打印在后端日志一次。
  admin_password: ""
  # algorithm: HS256
  # access_token_expire_minutes: 10080   # 7 天

# ── 跨域 CORS ───────────────────────────────────────────────────────────────
# 默认 ['*'] 放开(本地开发)。⚠️ 生产填明确的前端域名,否则任意站点可跨域调用。
# 含 '*' 时浏览器禁止携带凭据,allow_credentials 会被强制为 False。
cors:
  allow_origins:
    - "*"
    # - "https://wenshu.example.com"

# ── Langfuse 可观测(可选)─────────────────────────────────────────────────
# 默认关闭。需要 trace/评测对比时:用 `docker compose --profile observability up -d`
# 起 Langfuse,再把 enabled 改 true,并填上与 compose 中 LANGFUSE_INIT_* 一致的 key。
langfuse:
  enabled: false
  public_key: "pk-lf-..."
  secret_key: "sk-lf-..."
  host: ${oc.env:WENSHU_LANGFUSE_HOST,"http://localhost:3000"}
