# 构建上下文排除项:加速构建、缩小镜像、防止密钥/无关文件进镜像。

# Python 缓存与虚拟环境(镜像内重新 uv sync 生成)
__pycache__/
*.py[oc]
.venv/
build/
dist/
*.egg-info/

# 版本控制与 IDE
.git/
.gitignore
.vscode/

# 敏感配置:运行时通过挂载提供,绝不进镜像
conf/app_config.yaml
conf/meta_config*.json

# 日志与再生产物
logs/
acc.log
*.log
evals/baselines/*

# 前端(单独构建/托管,不进后端镜像)
wenshu-frontend/

# 数据与文档
test_data/
docs/
skills-main/
docker/mysql/
